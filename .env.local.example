# Copia este archivo como .env.local y completa los valores reales.
# .env.local nunca se sube a git (ver .gitignore).

# Supabase — Project Settings > API. La anon key es pública por diseño,
# pero de todas formas nunca compartas aquí la service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cal.com — tu nombre de usuario (ej. si tu link es cal.com/jenniferrugeles,
# el valor es "jenniferrugeles"). Mientras esté vacío, /agenda muestra un
# aviso y enruta a contacto/WhatsApp.
NEXT_PUBLIC_CALCOM_USERNAME=

# Sanity — sanity.io/manage → tu proyecto. Ambos son públicos (no son
# secretos), necesarios para leer el blog y para entrar a /studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# URL pública del sitio (para metadatos y schema.org del blog).
NEXT_PUBLIC_SITE_URL=https://jenniferrugeles.com

# Secreto para el webhook de revalidación de Sanity (lo inventas tú, ej. una
# frase larga aleatoria) — este sí es secreto, no lo compartas en el chat.
SANITY_REVALIDATE_SECRET=
